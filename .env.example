# Stripe restricted key (recommended) or secret key. Starts with rk_test_/rk_live_ or sk_test_/sk_live_.
STRIPE_SECRET_KEY=XXX
# Optional: port for the local dashboard
PORT=4242
# Required: login for the dashboard (use a long, unique password)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Optional: limit what this user sees — only:<product name prefix> or hide:<product name prefix>
DASHBOARD_SCOPE=
# More users: repeat with _2, _3, ... (e.g. DASHBOARD_USER_2, DASHBOARD_PASSWORD_2, DASHBOARD_SCOPE_2)

# Money Master: use the Sentink user whose scope excludes Sentink Plus.
MONEY_MASTER_USER=sentink
MONEY_MASTER_CURRENCY=aed
# Install accountant/v2/api/stripe_sync.php and migrations/stripe_sync.sql first.
MONEY_MASTER_SYNC_URL=https://money-master.app/v2/api/stripe_sync.php
# Same random token as STRIPE_SYNC_TOKEN on the Money Master PHP server (32+ characters).
MONEY_MASTER_SYNC_TOKEN=

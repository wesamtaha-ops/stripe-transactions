# Stripe restricted key (recommended) or secret key. Starts with rk_test_/rk_live_ or sk_test_/sk_live_.
STRIPE_SECRET_KEY=XXX
# Optional: port for the local dashboard
PORT=4242
# Required: login for the dashboard (use a long, unique password)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Optional: limit what this user sees — only:<product name prefix> or hide:<product name prefix>
DASHBOARD_SCOPE=
# More users: repeat with _2, _3, ... (e.g. DASHBOARD_USER_2, DASHBOARD_PASSWORD_2, DASHBOARD_SCOPE_2)
